{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "courtneyr.dev",
  "description": "Brand design system for Courtney Robertson — Open Source Developer Advocate, WordPress educator, IndieWeb contributor. Warm, teacher-ish, shape-layered.",
  "version": "1.0.0",
  "tone": "warm, approachable, teacher-ish, conversational",
  "color": {
    "palette": {
      "russian-violet": { "value": "#241c4a", "description": "Primary ink, headings, nav" },
      "periwinkle":     { "value": "#bcb5e3", "description": "Dark-mode ink, soft violet accents" },
      "glaucous":       { "value": "#647baf", "description": "Secondary text, borders" },
      "sky-blue":       { "value": "#8ecae6", "description": "Signature shape color, soft backgrounds" },
      "blue-green":     { "value": "#219ebc", "description": "Second accent, link hover" },
      "cerulean":       { "value": "#126782", "description": "Deeper blue, video post-type" },
      "prussian-blue":  { "value": "#023047", "description": "Dark-mode soft surface" },
      "selective-yellow": { "value": "#ffb703", "description": "Dark-mode primary, highlights" },
      "ut-orange":      { "value": "#fb8500", "description": "Primary CTA, links, brand warmth" },
      "light-orange":   { "value": "#fee2c3", "description": "Soft background shapes" },
      "cream":          { "value": "#fdfaf4", "description": "Page surface (light mode)" }
    },
    "semantic": {
      "light": {
        "surface":        "#fdfaf4",
        "surface-soft":   "#fee2c3",
        "surface-elevated": "#ffffff",
        "ink":            "#241c4a",
        "ink-muted":      "#647baf",
        "ink-inverse":    "#fdfaf4",
        "primary":        "#fb8500",
        "primary-ink":    "#ffffff",
        "accent":         "#219ebc",
        "accent-shape":   "#8ecae6",
        "border":         "rgba(36,28,74,0.12)"
      },
      "dark": {
        "surface":        "#0a0f24",
        "surface-soft":   "#023047",
        "surface-elevated": "#0f1530",
        "ink":            "#bcb5e3",
        "ink-muted":      "#647baf",
        "ink-inverse":    "#241c4a",
        "primary":        "#ffb703",
        "primary-ink":    "#241c4a",
        "accent":         "#8ecae6",
        "accent-shape":   "#126782",
        "border":         "rgba(188,181,227,0.15)"
      }
    },
    "post-types": {
      "blog":     { "emoji": "📰", "color": "#fb8500" },
      "link":     { "emoji": "🔗", "color": "#219ebc" },
      "video":    { "emoji": "📹", "color": "#126782" },
      "audio":    { "emoji": "🎧", "color": "#126782" },
      "quote":    { "emoji": "🔖", "color": "#241c4a" },
      "aside":    { "emoji": "🗯️", "color": "#647baf" },
      "status":   { "emoji": "🖊️", "color": "#647baf" },
      "speaking": { "emoji": "🗣️", "color": "#ffb703" },
      "book":     { "emoji": "📚", "color": "#241c4a" }
    }
  },
  "typography": {
    "family": {
      "sans":  "\"Mona Sans\", system-ui, -apple-system, sans-serif",
      "mono":  "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "notes": "Mona Sans is a variable font loaded by the Ollie block theme. Use its width axis (font-stretch) to establish hierarchy instead of a second typeface.",
    "stretch": {
      "condensed": "75%",
      "normal":    "100%",
      "wide":      "115%",
      "expanded":  "125%"
    },
    "scale": {
      "display": { "size": "clamp(2.25rem, 5vw + 1rem, 3.5rem)", "weight": 900, "stretch": "125%", "leading": 1.05, "tracking": "-0.02em", "use": "Hero H1" },
      "h1":      { "size": "clamp(1.875rem, 3vw + 1rem, 2.5rem)", "weight": 900, "stretch": "125%", "leading": 1.1,  "tracking": "-0.02em", "use": "Page titles" },
      "h2":      { "size": "clamp(1.5rem, 2vw + 0.75rem, 2.25rem)", "weight": 800, "stretch": "115%", "leading": 1.15, "tracking": "-0.01em", "use": "Section titles" },
      "h3":      { "size": "1.5rem",     "weight": 700, "stretch": "110%", "leading": 1.2,  "use": "Subsection titles" },
      "h4":      { "size": "1.125rem",   "weight": 700, "stretch": "100%", "leading": 1.3,  "use": "Stream card title (blog/video)" },
      "lead":    { "size": "1.25rem",    "weight": 400, "stretch": "100%", "leading": 1.55, "use": "Intro paragraph" },
      "body":    { "size": "1.0625rem",  "weight": 400, "stretch": "100%", "leading": 1.55, "use": "Paragraphs, post content" },
      "small":   { "size": "0.875rem",   "weight": 500, "stretch": "95%",  "use": "Captions" },
      "meta":    { "size": "0.75rem",    "weight": 600, "stretch": "75%",  "tracking": "0.08em", "uppercase": true, "use": "Chips, labels, timestamps" }
    }
  },
  "spacing": {
    "base": "0.25rem",
    "scale": ["0.25rem","0.5rem","0.75rem","1rem","1.25rem","1.5rem","2rem","2.5rem","3rem","4rem","5rem","6rem"]
  },
  "radius": {
    "xs":   "0.25rem",
    "sm":   "0.5rem",
    "md":   "0.75rem",
    "lg":   "1.25rem",
    "xl":   "2rem",
    "2xl":  "3rem",
    "full": "9999px",
    "default-image": "1.25rem",
    "default-card":  "1.25rem",
    "default-pill":  "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(36,28,74,0.06)",
    "md": "0 4px 12px -2px rgba(36,28,74,0.1)",
    "lg": "0 10px 30px -10px rgba(36,28,74,0.25), 0 2px 8px rgba(36,28,74,0.08)",
    "float-badge": "0 10px 30px -10px rgba(36,28,74,0.25), 0 2px 8px rgba(36,28,74,0.08)"
  },
  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "slow": "400ms",
    "ease-out":   "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
    "notes": "All non-essential motion must be gated behind @media (prefers-reduced-motion: no-preference). See components.css for the cr-drift animation pattern."
  },
  "signature-patterns": {
    "shape-layering": {
      "description": "Every feature image sits in front of a soft circle. Use .cr-shape-frame. Add a .cr-float-badge nearby for the Airo-style overlap effect.",
      "rules": [
        "One big circle + one small badge per image. That is the rhythm.",
        "Circle fill must be sky-blue, light-orange, or periwinkle. Never orange or violet.",
        "Image corner-radius: 1.25rem (20px).",
        "Offset the circle so ~30% peeks out from behind the image.",
        "Never combine with heavy drop shadows — the shape IS the depth.",
        "Don't badge-overlap on thumbnails under 200px."
      ]
    },
    "aggregate-stream": {
      "description": "Hybrid homepage: keep hero + newsletter, then below them a chronological feed that mixes all post types (Post Formats, IndieWeb Post Kinds, videos, podcasts, speaking).",
      "modeled-after": "https://nerdy.dev — Adam Argyle's single-stream aggregate",
      "card-pattern": "emoji avatar (44px circle) + body with type chip + timestamp + title + tag row"
    }
  },
  "voice": {
    "tone": "Warm, conversational, teacher-ish. Jen Hatmaker meets Morten Rand-Hendriksen.",
    "avoid": ["generic AI-sounding phrasing", "corporate buzzwords", "'delve', 'navigate', 'leverage', 'robust solution'"],
    "do": ["speak plainly", "use second person (you) when explaining", "cite sources", "show your work"]
  },
  "technical-context": {
    "platform": "WordPress",
    "theme": "Ollie block theme (with Ollie Pro)",
    "css-application": "Ollie Manage CSS Classes panel OR child theme stylesheet",
    "fonts-loaded-by": "Ollie theme.json — no additional font loading required",
    "accessibility-target": "WCAG AA for body text, AAA where achievable",
    "motion-policy": "prefers-reduced-motion respected site-wide",
    "indieweb-plugins-active": ["Post Formats for Block Themes", "Link Extension for XFN", "ActivityPub", "IndieWeb", "IndieWeb Post Kinds"]
  }
}
